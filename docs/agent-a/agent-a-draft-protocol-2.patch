diff --git a/tests/server/draft-protocol.test.js b/tests/server/draft-protocol.test.js
new file mode 100644
index 0000000..06749bb
--- /dev/null
+++ b/tests/server/draft-protocol.test.js
@@ -0,0 +1,238 @@
+// Draft protocol 2: a real draft revision, conditional whole-draft saves and an atomic comment append.
+// The native Plannotator client keeps its unconditional saves; these additions only protect writers
+// that opt in (the IAMCEO direct screen) from replacing another window's draft.
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import Fastify from 'fastify';
+import { Repository } from '../../src/server/repository.js';
+import { installAuth } from '../../src/server/auth.js';
+import { installPlannotator } from '../../src/server/plannotator.js';
+import { installAutomaticCommentAnswers } from '../../src/server/auto-comments.js';
+
+async function open(t) {
+  const repository = new Repository(':memory:');
+  const app = Fastify({ forceCloseConnections: true });
+  const asked = [];
+  installAuth(app, {});
+  app.setErrorHandler((error, req, reply) => reply.code(error.statusCode ?? 500).send({ code: error.code, error: error.message }));
+  const bridge = installPlannotator(app, repository);
+  installAutomaticCommentAnswers(app, repository, { ...bridge, enabled: true, dispatchTurn: async input => {
+    asked.push(input.displayQuestion.prompt);
+    return { question: input.displayQuestion, response: { questionId: input.questionId, text: 'answer', isStreaming: false, createdAt: Date.now() } };
+  } });
+  app.addHook('onClose', async () => repository.close());
+  await app.ready();
+  t.after(() => app.close());
+  const session = async body => (await app.inject({ method: 'POST', url: '/api/plannotator/sessions', payload: body ?? { artifact_id: 'enouv-workbench' } })).json();
+  const review = await session();
+  const as = id => (url, payload, method = payload === undefined ? 'GET' : 'POST') => app.inject({ method, url,
+    headers: { 'x-enouv-artifact': review.artifact_id, 'x-enouv-review-session': id }, ...(payload === undefined ? {} : { payload }) });
+  return { app, repository, review, session, as, request: as(review.id), asked };
+}
+const comment = (id, extra = {}) => ({ id, type: 'GLOBAL_COMMENT', text: `question ${id}`, originalText: '', ...extra });
+const settle = () => new Promise(resolve => setTimeout(resolve, 30));
+const revision = response => Number(response.headers['x-enouv-draft-revision']);
+
+test('a session advertises draft protocol 2 and every draft mutation moves draftRevision', async t => {
+  const { review, request } = await open(t);
+  assert.deepEqual(review.capabilities, { draft_protocol: 2, annotation_if_draft_revision: true });
+  assert.equal(review.draft_revision, 0);
+  const empty = await request('/api/draft');
+  assert.equal(empty.statusCode, 404);
+  assert.equal(revision(empty), 0);
+  assert.deepEqual(empty.json(), { found: false, draftGeneration: 0 });
+  // The native client's ordinary save: same generation, no condition. It still succeeds.
+  const first = await request('/api/draft', { draftGeneration: 0, annotations: [], globalAttachments: [], editedMarkdown: 'one' });
+  assert.equal(first.statusCode, 200);
+  assert.deepEqual(first.json(), { ok: true });
+  assert.equal(revision(first), 1);
+  const second = await request('/api/draft', { draftGeneration: 0, annotations: [], globalAttachments: [], editedMarkdown: 'two' });
+  assert.equal(revision(second), 2);
+  const now = await request('/api/draft');
+  assert.equal(revision(now), 2);
+  // The body keeps the native shape: no extra revision field.
+  assert.deepEqual(now.json(), { draftGeneration: 0, annotations: [], globalAttachments: [], editedMarkdown: 'two', documents: [] });
+  assert.equal((await request('/api/draft?generation=0', undefined, 'DELETE')).statusCode, 200);
+  assert.equal(revision(await request('/api/draft')), 3);
+});
+
+test('a conditional save is refused, not applied, when another window saved first', async t => {
+  const { request } = await open(t);
+  await request('/api/draft', { draftGeneration: 0, annotations: [], globalAttachments: [], editedMarkdown: 'base' });
+  const read = revision(await request('/api/draft'));
+  // Another window saves with the same generation after our read.
+  await request('/api/draft', { draftGeneration: 0, annotations: [], globalAttachments: [{ name: 'other.png', path: '/assets/x' }], editedMarkdown: 'other window' });
+  const stale = await request('/api/draft', { draftGeneration: 0, ifDraftRevision: read, annotations: [], globalAttachments: [], editedMarkdown: 'ours' });
+  assert.equal(stale.statusCode, 409);
+  assert.equal(stale.json().code, 'draft_conflict');
+  assert.equal(stale.json().draftRevision, read + 1);
+  const reread = await request('/api/draft'), kept = reread.json();
+  assert.equal(kept.editedMarkdown, 'other window');
+  assert.equal(kept.globalAttachments.length, 1);
+  const ok = await request('/api/draft', { draftGeneration: 0, ifDraftRevision: revision(reread), annotations: [], globalAttachments: kept.globalAttachments, editedMarkdown: 'ours after reread' });
+  assert.equal(ok.statusCode, 200);
+  const saved = (await request('/api/draft')).json();
+  assert.equal(saved.editedMarkdown, 'ours after reread');
+  assert.equal(saved.ifDraftRevision, undefined);
+  assert.equal((await request('/api/draft', { draftGeneration: 0, ifDraftRevision: -1, annotations: [], globalAttachments: [] })).statusCode, 400);
+});
+
+test('an atomic comment append keeps direct edits, attachments and comments saved by other windows', async t => {
+  const { request, asked } = await open(t);
+  await request('/api/draft', { draftGeneration: 0, annotations: [{ id: 'theirs', type: 'COMMENT', text: 'their comment', originalText: '', createdA: 1 }],
+    globalAttachments: [{ name: 'other.png', path: '/assets/x' }], editedMarkdown: 'their direct edit', codeAnnotations: [{ id: 'c1' }] });
+  const added = await request('/api/draft/annotations', { annotation: comment('ours') });
+  assert.equal(added.statusCode, 200, added.body);
+  assert.equal(added.json().id, 'ours');
+  const draft = (await request('/api/draft')).json();
+  assert.equal(draft.editedMarkdown, 'their direct edit');
+  assert.deepEqual(draft.annotations.map(a => a.id), ['theirs', 'ours']);
+  assert.equal(draft.globalAttachments.length, 1);
+  assert.deepEqual(draft.codeAnnotations, [{ id: 'c1' }]);
+  await settle();
+  // The new comment started exactly one answer; the restored historic comment did not.
+  assert.deepEqual(asked, ['question ours']);
+  // A later whole-draft save by the other window omits our comment. The durable comment stays.
+  await request('/api/draft', { draftGeneration: 0, annotations: [], globalAttachments: [], editedMarkdown: 'their next edit' });
+  const listed = (await request('/api/external-annotations')).json().annotations.map(a => a.id);
+  assert.ok(listed.includes('ours'));
+});
+
+test('a resent comment confirms the first result; the same id with other content is refused', async t => {
+  const { request, asked } = await open(t);
+  const first = await request('/api/draft/annotations', { annotation: comment('same') });
+  const again = await request('/api/draft/annotations', { annotation: comment('same') });
+  assert.equal(first.statusCode, 200);
+  assert.equal(again.statusCode, 200);
+  assert.equal(again.json().duplicate, true);
+  assert.equal((await request('/api/draft')).json().annotations.filter(a => a.id === 'same').length, 1);
+  const other = await request('/api/draft/annotations', { annotation: comment('same', { text: 'different' }) });
+  assert.equal(other.statusCode, 409);
+  assert.equal(other.json().code, 'idempotency_conflict');
+  // Still confirmed after another window's save dropped it from the draft.
+  await request('/api/draft', { draftGeneration: 0, annotations: [], globalAttachments: [] });
+  const late = await request('/api/draft/annotations', { annotation: comment('same') });
+  assert.equal(late.json().duplicate, true);
+  assert.equal((await request('/api/draft')).json().annotations.length, 0);
+  await settle();
+  assert.deepEqual(asked, ['question same']);
+});
+
+test('a new comment on an older canonical review is refused in the same transaction; reading and replying stay', async t => {
+  const { repository, review, session, as, request } = await open(t);
+  assert.equal((await request('/api/draft/annotations', { annotation: comment('root') })).statusCode, 200);
+  await settle();
+  const state = repository.require(review.artifact_id), block = state.blocks.find(b => !b.archived);
+  repository.run(review.artifact_id, { command_id: 'make-new-canonical', type: 'edit_block', block_id: block.id, base_revision: block.revision,
+    context_revision: state.context_revision, content: { ...block.content, body: `${block.content.body}\n\nnew canonical` } }, { id: 'local-user', role: 'user' });
+  const latest = await session();
+  assert.notEqual(latest.id, review.id);
+  const old = await session({ artifact_id: review.artifact_id, resume_session_id: review.id });
+  assert.equal(old.stale, true);
+  const refused = await request('/api/draft/annotations', { annotation: comment('late') });
+  assert.equal(refused.statusCode, 409);
+  assert.equal(refused.json().code, 'revision_conflict');
+  assert.equal((await request('/api/draft')).json().annotations.some(a => a.id === 'late'), false);
+  // The older review still reads its comments and takes replies to them.
+  assert.equal((await request('/api/external-annotations')).statusCode, 200);
+  assert.equal((await request('/api/external-annotations', { inReplyTo: 'root', text: 'follow-up on the old version' })).statusCode, 200);
+  // A resend of the comment saved before the canonical change is still confirmed.
+  assert.equal((await request('/api/draft/annotations', { annotation: comment('root') })).json().duplicate, true);
+  assert.equal((await as(latest.id)('/api/draft/annotations', { annotation: comment('current') })).statusCode, 200);
+});
+
+test('a conditional comment append checks the resend, the canonical document and the draft revision in the write transaction', async t => {
+  const { repository, review, request } = await open(t);
+  // The writer read the draft at revision 0 and appends on that condition.
+  const first = await request('/api/draft/annotations', { annotation: comment('one'), ifDraftRevision: 0 });
+  assert.equal(first.statusCode, 200, first.body);
+  assert.equal(first.json().draftRevision, 1);
+  // Another window saves after the writer's next read (revision 1): nothing is appended.
+  const theirs = await request('/api/draft', { draftGeneration: 0, annotations: (await request('/api/draft')).json().annotations, globalAttachments: [], editedMarkdown: 'their edit' });
+  assert.equal(theirs.statusCode, 200);
+  const before = await request('/api/draft');
+  const moved = await request('/api/draft/annotations', { annotation: comment('two'), ifDraftRevision: 1 });
+  assert.equal(moved.statusCode, 409);
+  assert.deepEqual(moved.json(), { ok: false, code: 'draft_conflict', draftGeneration: 0, draftRevision: 2 });
+  const unchanged = await request('/api/draft');
+  assert.deepEqual(unchanged.json(), before.json());
+  assert.equal(revision(unchanged), revision(before));
+  // A resent id is confirmed before the condition is looked at, even with the old revision.
+  const again = await request('/api/draft/annotations', { annotation: comment('one'), ifDraftRevision: 0 });
+  assert.equal(again.statusCode, 200);
+  assert.equal(again.json().duplicate, true);
+  // Malformed conditions and unknown fields are refused without a write.
+  for (const bad of [-1, 1.5, '2', null]) {
+    assert.equal((await request('/api/draft/annotations', { annotation: comment('bad'), ifDraftRevision: bad })).statusCode, 400, String(bad));
+  }
+  assert.equal((await request('/api/draft/annotations', { annotation: comment('bad'), ifDraftRevision: 2, extra: 1 })).statusCode, 400);
+  // The canonical document changes after the writer's read. The draft revision still matches,
+  // yet the append is refused in the same transaction and the stored draft is untouched.
+  const state = repository.require(review.artifact_id), block = state.blocks.find(b => !b.archived);
+  repository.run(review.artifact_id, { command_id: 'make-new-canonical-cas', type: 'edit_block', block_id: block.id, base_revision: block.revision,
+    context_revision: state.context_revision, content: { ...block.content, body: `${block.content.body}\n\nnew canonical` } }, { id: 'local-user', role: 'user' });
+  const stale = await request('/api/draft/annotations', { annotation: comment('three'), ifDraftRevision: 2 });
+  assert.equal(stale.statusCode, 409);
+  assert.equal(stale.json().code, 'revision_conflict');
+  const kept = await request('/api/draft');
+  assert.deepEqual(kept.json(), before.json());
+  assert.equal(revision(kept), revision(before));
+  // The comment saved before the canonical change is still confirmed on resend.
+  assert.equal((await request('/api/draft/annotations', { annotation: comment('one'), ifDraftRevision: 2 })).json().duplicate, true);
+});
+
+test('a conditional comment append to a submitted review is refused as submitted, whatever the condition', async t => {
+  const { request, review } = await open(t);
+  assert.equal((await request('/api/draft/annotations', { annotation: comment('kept'), ifDraftRevision: 0 })).statusCode, 200);
+  const submitted = await request('/api/feedback', { serverSession: review.server_session, feedback: '', annotations: [], nothingToSend: true });
+  assert.equal(submitted.statusCode, 200, submitted.body);
+  const current = revision(await request('/api/draft'));
+  for (const condition of [current, current + 5]) {
+    const closed = await request('/api/draft/annotations', { annotation: comment('after-submit'), ifDraftRevision: condition });
+    assert.equal(closed.statusCode, 409);
+    assert.equal(closed.json().decided, true);
+  }
+  assert.equal(revision(await request('/api/draft')), current);
+  // The comment saved before the submit is still confirmed on resend.
+  assert.equal((await request('/api/draft/annotations', { annotation: comment('kept'), ifDraftRevision: 0 })).json().duplicate, true);
+});
+
+test('malformed, reply-shaped and submitted-review appends are refused without touching the draft', async t => {
+  const { request, review } = await open(t);
+  for (const annotation of [comment('bad id!'), comment('__proto__'), comment('a', { type: 'OTHER' }), comment('b', { text: '   ' }),
+    comment('c', { inReplyTo: 'x' }), comment('d', { source: 'enouv-comment:d' }), comment('e', { images: [{ path: '/api/config', name: 'x' }] }),
+    comment('f', { aiSettings: { providerId: 'p', tool: 'x' } })]) {
+    assert.equal((await request('/api/draft/annotations', { annotation })).statusCode, 400, JSON.stringify(annotation));
+  }
+  assert.equal((await request('/api/draft/annotations', { annotation: comment('g'), extra: 1 })).statusCode, 400);
+  assert.equal((await request('/api/draft')).statusCode, 404);
+  const deletion = await request('/api/draft/annotations', { annotation: { id: 'del', type: 'DELETION', originalText: 'remove this' } });
+  assert.equal(deletion.statusCode, 200, deletion.body);
+  const submitted = await request('/api/feedback', { serverSession: review.server_session, feedback: '', annotations: [], nothingToSend: true });
+  assert.equal(submitted.statusCode, 200, submitted.body);
+  const closed = await request('/api/draft/annotations', { annotation: comment('after-submit') });
+  assert.equal(closed.statusCode, 409);
+  assert.equal(closed.json().decided, true);
+});
+
+test('a conditional review submit is refused when the draft moved, and a resent submit confirms the first result', async t => {
+  const { request, review } = await open(t);
+  await request('/api/draft/annotations', { annotation: comment('first') });
+  const read = await request('/api/draft'), draft = read.json();
+  // Another window adds a comment after the submitter read the draft.
+  await request('/api/draft', { draftGeneration: 0, annotations: [...draft.annotations, { id: 'late', type: 'COMMENT', text: 'late comment', originalText: '', createdA: Date.now() }], globalAttachments: [] });
+  const payload = { serverSession: review.server_session, feedback: 'first', annotations: draft.annotations, ifDraftRevision: revision(read) };
+  const stale = await request('/api/feedback', payload);
+  assert.equal(stale.statusCode, 409);
+  assert.equal(stale.json().code, 'draft_conflict');
+  const kept = await request('/api/draft');
+  assert.deepEqual(kept.json().annotations.map(a => a.id), ['first', 'late']);
+  const current = { ...payload, annotations: kept.json().annotations, ifDraftRevision: revision(kept) };
+  const sent = await request('/api/feedback', current);
+  assert.equal(sent.statusCode, 200, sent.body);
+  assert.equal(sent.json().feedback_ids.length, 3);
+  // The same submit again (response lost): the stored result comes back although the draft revision moved on submit.
+  const again = await request('/api/feedback', current);
+  assert.equal(again.statusCode, 200);
+  assert.deepEqual(again.json(), sent.json());
+});
